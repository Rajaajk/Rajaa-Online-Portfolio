<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Management — Rajaa Khan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>

  :root{
    --maroon:#6B1F2C; --maroon-deep:#4A1520; --maroon-soft:#8B2D3D;
    --gold:#B8893E; --gold-soft:#D4A961; --gold-light:#E8C98A;
    --cream:#FBF6EE; --cream-2:#F5EDE0; --cream-3:#EBE0D1;
    --ink:#2A1A1E; --ink-soft:#5C4A4F; --line:rgba(107,31,44,0.15); --line-strong:rgba(107,31,44,0.3);
    --navy:#1A2332;
    --shadow-sm:0 4px 12px rgba(107,31,44,0.08);
    --shadow-md:0 12px 40px rgba(107,31,44,0.15);
    --shadow-lg:0 24px 80px rgba(107,31,44,0.25);
    --transition:all 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  
  /* Navigation */
  nav{position:fixed;top:0;left:0;right:0;z-index:100;backdrop-filter:blur(20px) saturate(180%);background:rgba(251,246,238,0.92);border-bottom:1px solid var(--line);transition:var(--transition)}
  nav.scrolled{padding:8px 0;box-shadow:var(--shadow-sm)}
  .nav-wrap{max-width:1240px;margin:0 auto;padding:18px 32px;display:flex;align-items:center;justify-content:space-between;gap:32px}
  .logo{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:24px;color:var(--maroon);letter-spacing:.5px;display:flex;align-items:center;gap:12px;text-decoration:none;position:relative}
  .logo-mark{
    width:40px;height:40px;border-radius:50%;
    background:linear-gradient(135deg,var(--maroon),var(--maroon-deep));
    color:var(--cream);display:grid;place-items:center;
    font-style:italic;font-size:20px;font-weight:600;
    box-shadow:0 4px 16px rgba(107,31,44,0.3);
    transition:var(--transition)
  }
  .logo:hover .logo-mark{transform:rotate(15deg) scale(1.05)}
  
  .nav-links{display:flex;gap:28px;list-style:none}
  .nav-links a{
    color:var(--ink-soft);text-decoration:none;font-weight:500;font-size:13.5px;
    letter-spacing:.3px;transition:var(--transition);position:relative;padding:4px 0
  }
  .nav-links a::after{
    content:'';position:absolute;bottom:0;left:0;width:0;height:2px;
    background:linear-gradient(90deg,var(--maroon),var(--gold));
    transition:width 0.3s;border-radius:2px
  }
  .nav-links a:hover, .nav-links a.active{color:var(--maroon)}
  .nav-links a:hover::after, .nav-links a.active::after{width:100%}
  
  .nav-cta{
    padding:11px 24px;background:var(--maroon);color:var(--cream);
    font-weight:500;text-decoration:none;font-size:13px;letter-spacing:.8px;
    text-transform:uppercase;transition:var(--transition);border:1px solid var(--maroon);
    border-radius:30px;position:relative;overflow:hidden
  }
  .nav-cta:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
  .nav-cta span{position:relative;z-index:1}

  /* Mobile Menu Toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 10px;
    z-index: 101;
  }
  .menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--maroon);
    transition: var(--transition);
  }

  @media (max-width: 992px) {
    .nav-wrap { padding: 15px 24px; }
    .nav-links { display: none; }
    .menu-toggle { display: flex; }
    .nav-cta { display: none; }
    
    .nav-links.mobile-active {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--cream);
      padding: 40px;
      gap: 24px;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      text-align: center;
      animation: slideDown 0.4s ease forwards;
    }
    .nav-links.mobile-active a { font-size: 18px; }
    
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }

  @media (max-width: 480px) {
    .logo { font-size: 20px; }
    .logo-mark { width: 32px; height: 32px; font-size: 16px; }
  }


  /* Footer */
  footer{
    text-align:center;padding:60px 32px;color:var(--ink-soft);
    font-size:13.5px;border-top:1px solid var(--line);
    background:linear-gradient(180deg,var(--cream-2),var(--cream));
    position:relative;
    clear: both;
  }
  footer::before{
    content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
    width:120px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent)
  }
  footer .ornament{
    color:var(--gold);font-size:20px;margin-bottom:20px;
    letter-spacing:10px;opacity:0.8
  }
  footer a{color:var(--maroon);text-decoration:none;font-weight:500;transition:color 0.2s}
  footer a:hover{color:var(--maroon-deep);text-decoration:underline}

  /* Scroll Progress Indicator */
  .scroll-progress{
    position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--maroon),var(--gold));
    z-index:200;transition:width 0.1s ease;transform-origin:left
  }


        :root {
            --maroon: #5D1A2D;
            --maroon-deep: #3D0F1C;
            --maroon-muted: #8B3A4A;
            --maroon-light: #7A2A3E;
            --beige: #D4A574;
            --beige-light: #E8C9A0;
            --beige-warm: #C49460;
            --cream: #F7F0E6;
            --cream-dark: #EDE4D3;
            --cream-warm: #F0E8DA;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--maroon);
            line-height: 1.6;
            font-weight: 300;
            overflow-x: hidden;
        }

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 2rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(247, 240, 230, 0.92);
            backdrop-filter: blur(12px);
            z-index: 100;
            border-bottom: 1px solid var(--beige-light);
        }

        .nav-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 400;
            color: var(--maroon);
            text-decoration: none;
        }

        .nav-logo em {
            font-style: italic;
            font-weight: 300;
            color: var(--maroon-muted);
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--maroon);
            font-size: 0.85rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            transition: color 0.3s;
            position: relative;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--maroon-muted);
        }

        .nav-links a.active::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 100%;
            height: 1px;
            background: var(--beige-warm);
        }

        .hero {
            padding: 12rem 4rem 6rem;
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -80px;
            width: 350px;
            height: 350px;
            background: var(--beige-light);
            border-radius: 50%;
            opacity: 0.4;
            z-index: 0;
        }

        .hero::after {
            content: '';
            position: absolute;
            bottom: 80px;
            right: 60px;
            width: 140px;
            height: 140px;
            background: var(--beige);
            border-radius: 50%;
            opacity: 0.3;
            z-index: 0;
        }

        .hero > * {
            position: relative;
            z-index: 1;
        }

        .hero-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--beige-warm);
            margin-bottom: 1.5rem;
            display: block;
        }

        h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 300;
            line-height: 1.1;
            color: var(--maroon);
            margin-bottom: 1.5rem;
        }

        h1 em {
            font-style: italic;
            font-weight: 400;
            color: var(--maroon-deep);
        }

        .hero-subtitle {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 300;
            font-style: italic;
            color: var(--beige-warm);
            max-width: 700px;
        }

        .stats-bar {
            display: flex;
            gap: 3rem;
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 1px solid var(--beige-light);
            flex-wrap: wrap;
            row-gap: 2rem;
        }

        .stat {
            text-align: left;
        }

        .stat-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--maroon);
            line-height: 1;
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--beige-warm);
            margin-top: 0.5rem;
            letter-spacing: 0.05em;
        }

        section {
            padding: 5rem 4rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            margin-bottom: 3rem;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid var(--beige-light);
            padding-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--maroon);
        }

        .section-title em {
            font-style: italic;
            color: var(--maroon-deep);
        }

        .section-meta {
            font-size: 0.85rem;
            color: var(--beige-warm);
            letter-spacing: 0.05em;
        }

        .verticals-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }

        .vertical-card {
            background: white;
            border: 1px solid var(--beige-light);
            padding: 2rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .vertical-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--maroon);
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }

        .vertical-card:hover {
            box-shadow: 0 20px 40px rgba(93, 26, 45, 0.08);
            transform: translateY(-4px);
        }

        .vertical-card:hover::before {
            transform: scaleX(1);
        }

        .vertical-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 400;
            color: var(--maroon);
            margin-bottom: 0.5rem;
        }

        .vertical-count {
            font-size: 0.8rem;
            color: var(--beige-warm);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .vertical-desc {
            font-size: 0.9rem;
            color: var(--beige-warm);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .vertical-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .v-tag {
            font-size: 0.7rem;
            padding: 0.3rem 0.7rem;
            background: var(--cream);
            color: var(--maroon);
            border-radius: 20px;
            letter-spacing: 0.02em;
        }

        .category-section {
            background: var(--cream-dark);
            padding: 4rem;
            margin: 4rem auto;
            max-width: 1200px;
            position: relative;
            overflow: hidden;
        }

        .category-section::before {
            content: '';
            position: absolute;
            top: -80px;
            left: -80px;
            width: 300px;
            height: 300px;
            background: var(--beige-light);
            border-radius: 50%;
            opacity: 0.5;
        }

        .category-section::after {
            content: '';
            position: absolute;
            bottom: -60px;
            right: -60px;
            width: 250px;
            height: 250px;
            background: var(--beige);
            border-radius: 50%;
            opacity: 0.3;
        }

        .category-section > * {
            position: relative;
            z-index: 1;
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .category-item {
            text-align: center;
            padding: 2rem;
            background: white;
            border: 1px solid var(--beige-light);
            transition: all 0.3s ease;
        }

        .category-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(93, 26, 45, 0.06);
        }

        .category-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--maroon);
            line-height: 1;
        }

        .category-title {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--maroon);
            margin: 1rem 0 0.5rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .category-desc {
            font-size: 0.85rem;
            color: var(--beige-warm);
            line-height: 1.6;
        }

        /* ===== PROCESS VISUAL SECTION ===== */
        .process-section {
            padding: 5rem 4rem 6rem;
            max-width: 1200px;
            margin: 0 auto;
            overflow: visible;
        }

        .process-visual {
            display: flex;
            align-items: stretch;
            gap: 0;
            margin-top: 3rem;
            position: relative;
        }

        .process-step {
            flex: 1;
            background: var(--maroon);
            border: none;
            padding: 3rem 2rem 2.5rem;
            text-align: center;
            position: relative;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            overflow: hidden;
            min-height: 280px;
        }

        .process-step:nth-child(1) { background: var(--maroon); }
        .process-step:nth-child(2) { background: var(--maroon-light); }
        .process-step:nth-child(3) { background: var(--maroon-muted); }
        .process-step:nth-child(4) { background: var(--maroon-deep); }

        .process-step::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.06);
            transform: translateY(100%);
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .process-step:hover::before {
            transform: translateY(0);
        }

        .process-step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 50%;
            right: -14px;
            width: 28px;
            height: 28px;
            border-top: 3px solid var(--beige);
            border-right: 3px solid var(--beige);
            transform: translateY(-50%) rotate(45deg);
            background: var(--cream);
            z-index: 2;
            transition: all 0.3s;
        }

        .process-step:hover:not(:last-child)::after {
            border-color: var(--beige-light);
            right: -16px;
        }

        .process-step:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 24px 48px rgba(93, 26, 45, 0.25);
            z-index: 5;
        }

        .process-step > * {
            position: relative;
            z-index: 1;
        }

        .process-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 4rem;
            font-weight: 300;
            color: rgba(212, 165, 116, 0.35);
            line-height: 1;
            margin-bottom: 1rem;
            transition: all 0.4s;
        }

        .process-step:hover .process-number {
            color: var(--beige);
            transform: scale(1.1);
        }

        .process-title {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--cream);
            margin-bottom: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .process-desc {
            font-size: 0.85rem;
            color: rgba(247, 240, 230, 0.7);
            line-height: 1.7;
            transition: color 0.3s;
        }

        .process-step:hover .process-desc {
            color: rgba(247, 240, 230, 0.95);
        }

        .process-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 1rem;
            border: 1.5px solid var(--beige);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s;
        }

        .process-step:hover .process-icon {
            background: var(--beige);
            transform: rotate(360deg);
        }

        .process-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--beige);
            fill: none;
            stroke-width: 1.5;
            transition: stroke 0.3s;
        }

        .process-step:hover .process-icon svg {
            stroke: var(--maroon);
        }

        /* ===== HORIZONTAL SCROLL SECTION ===== */
        .scroll-section {
            padding: 5rem 0;
            margin: 0 auto;
            max-width: 100%;
            overflow: hidden;
        }

        .scroll-section .section-header {
            padding: 0 4rem;
            max-width: 1200px;
            margin: 0 auto 3rem;
        }

        .scroll-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .filter-dropdown {
            position: relative;
        }

        .filter-btn {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: white;
            border: 1px solid var(--beige-light);
            color: var(--maroon);
            font-family: 'Inter', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-btn:hover {
            border-color: var(--beige-warm);
            background: var(--cream);
        }

        .filter-menu {
            position: absolute;
            top: calc(100% + 0.5rem);
            right: 0;
            background: white;
            border: 1px solid var(--beige-light);
            min-width: 160px;
            box-shadow: 0 8px 24px rgba(93, 26, 45, 0.08);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.3s ease;
            z-index: 50;
        }

        .filter-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .filter-menu button {
            display: block;
            width: 100%;
            padding: 0.75rem 1rem;
            background: none;
            border: none;
            color: var(--maroon);
            font-family: 'Inter', sans-serif;
            font-size: 0.8rem;
            text-align: left;
            cursor: pointer;
            transition: background 0.2s;
        }

        .filter-menu button:hover {
            background: var(--cream);
        }

        .filter-menu button.active {
            background: var(--cream-dark);
            font-weight: 500;
        }

        .scroll-track-wrapper {
            position: relative;
            padding: 0 4rem;
        }

        .scroll-track {
            display: flex;
            gap: 2rem;
            overflow-x: auto;
            scroll-behavior: smooth;
            scroll-snap-type: x mandatory;
            padding-bottom: 2rem;
            -webkit-overflow-scrolling: touch;
        }

        .scroll-track::-webkit-scrollbar {
            height: 4px;
        }

        .scroll-track::-webkit-scrollbar-track {
            background: var(--cream-dark);
        }

        .scroll-track::-webkit-scrollbar-thumb {
            background: var(--beige);
            border-radius: 2px;
        }

        .scroll-card {
            flex: 0 0 420px;
            scroll-snap-align: start;
            background: white;
            border: 1px solid var(--beige-light);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .scroll-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: var(--maroon);
            transform: scaleY(0);
            transition: transform 0.4s ease;
        }

        .scroll-card:hover {
            box-shadow: 0 20px 40px rgba(93, 26, 45, 0.08);
            transform: translateY(-4px);
        }

        .scroll-card:hover::before {
            transform: scaleY(1);
        }

        .scroll-card-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-bottom: 1px solid var(--beige-light);
            background: linear-gradient(135deg, var(--cream-dark), var(--cream-warm));
        }

        .scroll-card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .project-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
            font-weight: 500;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-live {
            color: var(--maroon-deep);
        }

        .status-ongoing {
            color: var(--beige-warm);
        }

        .project-org {
            font-size: 0.75rem;
            color: var(--beige-warm);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .project-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 400;
            color: var(--maroon);
            margin-bottom: 0.8rem;
            line-height: 1.2;
        }

